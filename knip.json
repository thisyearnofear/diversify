{
  "ignore": [
    "lib/openzeppelin-contracts/**",
    "lib/forge-std/**",
    "contracts/**",
    "contracts/test/**",
    "examples/**",
    ".agents/**",
    "docs/**"
  ],
  "ignoreBinaries": [],
  "ignoreDependencies": [],
  "ignoreWorkspaces": [],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,ts,mjs}", "scripts/smoke/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["pages/**/*.{ts,tsx}", "next.config.js"],
      "project": ["**/*.{ts,tsx,js,jsx}"]
    }
  }
}
