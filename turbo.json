{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HETZNER_API_URL",
    "NEXT_PUBLIC_STELLAR_TESTNET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "clean": {
      "cache": false
    }
  }
}
