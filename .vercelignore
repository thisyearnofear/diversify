# Keep Foundry / docs / video / tooling out of Vercel upload + traces.
# Patterns are root-anchored (/…) so apps/web/lib is NOT excluded.
/lib/
/contracts/
/docs/
/scripts/
/examples/
/videos/
/vendor/
/broadcast/
/cache/
/.agents/
/ops/
/.github/
/.husky/
/out/
/coverage/
**/*.tsbuildinfo

# Tests must never become serverless functions
**/__tests__/
**/*.test.ts
**/*.test.tsx
/apps/web/tests/
