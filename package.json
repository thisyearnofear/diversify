{
  "name": "diversifi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @diversifi/web dev",
    "build": "turbo run build --filter=@diversifi/shared --filter=@stable-station/mento-utils --filter=@diversifi/web",
    "start": "pnpm --filter @diversifi/web start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @diversifi/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean && rm -rf apps/web/.next out node_modules cache .cache",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "setup-arc-agent": "node scripts/setup-arc-agent.js",
    "create-wallet": "npx tsx --env-file=.env.local scripts/create-circle-wallet.ts",
    "test-x402": "node scripts/smoke/test-x402-hub.mjs",
    "test-x402-comprehensive": "node scripts/smoke/test-x402-comprehensive.mjs",
    "test-x402-frequency": "node scripts/smoke/test-x402-frequency.mjs",
    "generate-x402-volume": "node scripts/generate-x402-volume.mjs",
    "validate-agent": "npx tsx -e \"import { validateAgentConfig } from './packages/shared/src/utils/arc-agent-setup'; console.log(validateAgentConfig());\"",
    "register-agent": "npx tsx scripts/register-on-agentscan.ts",
    "register-erc8004": "npx tsx scripts/register-erc8004.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.8.6",
    "dotenv": "17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "ethers": "^5.7.2",
    "husky": "9.1.7",
    "jsdom": "29.0.0",
    "lint-staged": "17.0.8",
    "tsx": "4.22.4",
    "turbo": "^2.1.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.30.0",
  "peerDependencies": {
    "ethers": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.44.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  }
}
