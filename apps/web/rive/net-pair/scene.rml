<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" styleId="0:5" width="240" height="140" name="NetPair" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Draw order is front-to-back: first declared paints on top. -->

        <!-- Seal badge: emerald disc + check, stamps onto the coin junction on `settled`. -->
        <Node x="120" y="70" name="Badge" id="0:35" opacity="0" scaleX="0" scaleY="0">
