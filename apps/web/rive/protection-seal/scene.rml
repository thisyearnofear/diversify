                </AnimationState>

                <!-- Armed: holds the sealed pose; entering it fires `ready`. -->
                <AnimationState x="520" y="0" animationId="0:61" id="0:14" stateName="Armed">
                    <ListenerViewModelChange>
                        <BindablePropertyTrigger>
