             paints on top of the shield fill. -->
        <Shape x="48" y="46" name="Check" id="0:30">
            <PointsPath name="Path">
                <StraightVertex x="-7" y="0.5" radius="2.5"/>
                <StraightVertex x="-1.5" y="6" radius="2.5"/>
                <StraightVertex x="8" y="-7" radius="2.5"/>
            </PointsPath>
            <Stroke thickness="4" name="Stroke" id="0:31" cap="round">
                <SolidColor colorValue="FFFFFFFF" name="Color" id="0:32"/>
                <TrimPath start="0" end="0" name="Trim" id="0:33"/>
            </Stroke>
        </Shape>

        <!-- Shield: accent-filled pentagon that stamps in. -->
        <Shape x="48" y="46" name="Shield" id="0:20" opacity="0" scaleX="0" scaleY="0">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-16" y="-13" radius="3"/>
                <StraightVertex x="16" y="-13" radius="3"/>
                <StraightVertex x="16" y="5" radius="3"/>
                <StraightVertex x="0" y="19" radius="3"/>
