                <AnyState x="560" y="-120"/>
                <ExitState x="720" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>

                <!-- Idle: nothing drawn until the host arms the seal. -->
                <AnimationState x="160" y="0" animationId="0:60" id="0:12" stateName="Idle">
                    <StateTransition stateToId="0:13" duration="120">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="634"/>
