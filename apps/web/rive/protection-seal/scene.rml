                    </ListenerViewModelChange>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Idle holds the untouched (invisible) authored pose. -->
        <LinearAnimation duration="1" name="Empty" id="0:60" fps="60">
