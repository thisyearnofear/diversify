    <Artboard width="96" height="96" name="Seal" id="0:2" defaultStateMachineId="0:7" viewModelId="0:40" styleId="0:5">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Ring: accent stroke that trims closed when the seal arms. -->
        <Shape x="48" y="48" name="Ring" id="0:10">
            <Ellipse width="76" height="76" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="3.5" name="Stroke" id="0:11">
                <SolidColor colorValue="FF10B981" name="Color" id="0:15">
                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="37"/>
