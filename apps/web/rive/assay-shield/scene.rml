<Rive version="1" kind="fragment">
    <Artboard width="160" height="160" name="AssayShield" id="0:2" defaultStateMachineId="0:7" viewModelId="0:40" styleId="0:5">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Assay shield — the plan as a struck object. Materials, not
             colors: machined steel for reserve, gold for noble, living
             copper for EM legs that patina with drift, a ghost channel
             where the wallet is behind plan, a hallmark punched into
             the rim when a fact anchors on-chain, and the mint's maker
             mark set into the base while Guardian monitors.
             Draw order is front-to-back: first declared paints on top. -->

        <!-- StrikeFlash: the rim's receiving flash while the mark lands. -->
        <Shape x="80" y="80" name="StrikeFlash" id="0:60" opacity="0">
            <Ellipse width="126" height="126" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="2" name="Stroke">
                <SolidColor colorValue="FFB9C2CC" name="Color"/>
            </Stroke>
        </Shape>

        <!-- StrikeMark: the hallmark — two die-rings and an assay check,
             punched into the rim at 12 o'clock. -->
        <Node x="80" y="19" name="StrikeMark" id="0:61" opacity="0" scaleX="0" scaleY="0">
            <Shape name="StrikeOuter">
                <Ellipse width="11" height="11" originX="0.5" originY="0.5" name="Path"/>
                <Stroke thickness="1.2" name="Stroke">
                    <SolidColor colorValue="FFB9C2CC" name="Color"/>
                </Stroke>
            </Shape>
            <Shape name="StrikeInner">
                <Ellipse width="6.4" height="6.4" originX="0.5" originY="0.5" name="Path"/>
                <Stroke thickness="0.6" name="Stroke">
                    <SolidColor colorValue="80B9C2CC" name="Color"/>
                </Stroke>
            </Shape>
            <Shape name="StrikeCheck">
                <PointsPath name="Path">
                    <StraightVertex x="-1.9" y="0.4" radius="0.5"/>
                    <StraightVertex x="-0.6" y="1.6" radius="0.5"/>
                    <StraightVertex x="2.2" y="-1.6" radius="0.5"/>
                </PointsPath>
                <Stroke thickness="1.1" name="Stroke" cap="round">
                    <SolidColor colorValue="FFEAEDF0" name="Color"/>
                </Stroke>
            </Shape>
        </Node>

        <!-- PatinaOverlay: verdigris over the living-metal leg, opacity
             bound to `patina` (0-1, the host maps real drift to it). -->
        <Shape x="80" y="80" name="Patina" id="0:62" opacity="0">
            <Ellipse width="104" height="104" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="16" name="Stroke">
                <SolidColor colorValue="FF4E7D6E" name="Color"/>
                <TrimPath start="0.558" end="0.842" offset="0.25" name="Trim"/>
            </Stroke>
            <DataBindContext sourcePathIds="0:40-0:41" propertyKey="18"/>
        </Shape>

        <!-- GhostEdge: the bright inner lip of the unfilled channel. -->
        <Shape x="80" y="80" name="GhostEdge" id="0:63">
            <Ellipse width="90" height="90" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="1.5" name="Stroke">
                <SolidColor colorValue="59FFFFFF" name="Color"/>
                <TrimPath start="0.858" end="0.998" offset="0.25" name="Trim">
                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="114"/>
                </TrimPath>
            </Stroke>
        </Shape>

        <!-- GhostBed: the unfilled channel — the leg that should be
             here, rendered as machined metal not yet poured.
             `gapStart` (1 - gap share) drives its trim. -->
        <Shape x="80" y="80" name="GhostBed" id="0:64">
            <Ellipse width="104" height="104" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="16" name="Stroke">
                <SolidColor colorValue="3893A1AE" name="Color"/>
                <TrimPath start="0.858" end="0.998" offset="0.25" name="Trim">
                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="114"/>
                </TrimPath>
            </Stroke>
        </Shape>

        <!-- LegCopper: the living metal — EM exposure, patinas over time. -->
        <Shape x="80" y="80" name="LegCopper" id="0:65">
            <Ellipse width="104" height="104" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="16" name="Stroke">
                <SolidColor colorValue="FFB0703C" name="Color"/>
                <TrimPath start="0.558" end="0.842" offset="0.25" name="Trim"/>
            </Stroke>
        </Shape>

        <!-- LegGold: the noble metal — never weathers. -->
        <Shape x="80" y="80" name="LegGold" id="0:66">
            <Ellipse width="104" height="104" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="16" name="Stroke">
                <SolidColor colorValue="FFDFA83C" name="Color"/>
                <TrimPath start="0.358" end="0.542" offset="0.25" name="Trim"/>
            </Stroke>
        </Shape>

        <!-- LegSteel: the machined reserve — the calm surface. -->
        <Shape x="80" y="80" name="LegSteel" id="0:67">
            <Ellipse width="104" height="104" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="16" name="Stroke">
                <SolidColor colorValue="FF93A1AE" name="Color"/>
                <TrimPath start="0" end="0.342" offset="0.25" name="Trim"/>
            </Stroke>
        </Shape>

        <!-- InnerEdge: the machined inner lip of the ring. -->
        <Shape x="80" y="80" name="InnerEdge" id="0:68">
            <Ellipse width="88" height="88" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="1" name="Stroke">
                <SolidColor colorValue="33FFFFFF" name="Color"/>
            </Stroke>
        </Shape>

        <!-- RimRing: the outer machined rim — the metal flexes when the
             mark strikes. -->
        <Shape x="80" y="80" name="RimRing" id="0:69">
            <Ellipse width="122" height="122" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="1.5" name="Stroke">
                <SolidColor colorValue="FF565E68" name="Color"/>
            </Stroke>
        </Shape>

        <!-- MakerMark: the mint's sigil set into the base plate while
             Guardian monitors. Authored hidden; the Watched state
             reveals it. -->
        <Shape x="80" y="110" name="MakerMark" id="0:70" opacity="0">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-4" y="-3.2" radius="1"/>
                <StraightVertex x="4" y="-3.2" radius="1"/>
                <StraightVertex x="4" y="1.2" radius="1"/>
                <StraightVertex x="0" y="4.4" radius="1"/>
                <StraightVertex x="-4" y="1.2" radius="1"/>
            </PointsPath>
            <Fill name="Fill">
                <SolidColor colorValue="FF6B7280" name="Color"/>
            </Fill>
        </Shape>

        <!-- BasePlate: the plate every leg is set into. -->
        <Shape x="80" y="80" name="BasePlate" id="0:71">
            <Ellipse width="88" height="88" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="0D14181F" name="Color"/>
            </Fill>
        </Shape>

        <StateMachine name="AssayShield" id="0:7">
            <!-- Main: rest → strike → marked. -->
            <StateMachineLayer name="Main" id="0:8">
                <AnyState x="560" y="-120"/>
                <ExitState x="720" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>

                <AnimationState x="160" y="0" animationId="0:50" id="0:12" stateName="Rest">
                    <StateTransition stateToId="0:13" duration="80">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="340" y="0" animationId="0:51" id="0:13" stateName="Strike">
                    <StateTransition stateToId="0:14" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <AnimationState x="520" y="0" animationId="0:52" id="0:14" stateName="Marked">
                    <ListenerViewModelChange>
                        <BindablePropertyTrigger>
                            <DataBindContext sourcePathIds="0:40-0:46" propertyKey="686" direction="true"/>
                        </BindablePropertyTrigger>
                    </ListenerViewModelChange>
                    <StateTransition stateToId="0:12" duration="80">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Mark: the maker's mark appears while Guardian monitors —
                 orthogonal to the strike. -->
            <StateMachineLayer name="Mark" id="0:9">
                <EntryState>
                    <StateTransition stateToId="0:20"/>
                </EntryState>

                <AnimationState x="160" y="140" animationId="0:54" id="0:20" stateName="Unwatched">
                    <StateTransition stateToId="0:21" duration="250">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:44" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="340" y="140" animationId="0:53" id="0:21" stateName="Watched">
                    <StateTransition stateToId="0:20" duration="250">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:44" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Rest: the authored pose — binds still read live. Hold keys
             pin the rest pose explicitly (the net-pair hold convention:
             every state keys what it owns). -->
        <LinearAnimation duration="1" name="Rest" id="0:50" fps="60">
            <KeyedObject objectId="0:60">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:61">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:69">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Unwatched: the maker's mark stays unset — the Mark layer's
             own hold pose (each layer keys only what it owns). -->
        <LinearAnimation duration="1" name="Unwatched" id="0:54" fps="60">
            <KeyedObject objectId="0:70">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Strike: the rim flashes, the metal flexes, the mark punches
             in with an overshoot — the strike primitive. -->
        <LinearAnimation duration="36" name="Strike" id="0:51" fps="60">
            <KeyedObject objectId="0:60">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0.9" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="30" interpolationType="linear"/>
