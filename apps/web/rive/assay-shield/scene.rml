                    <KeyFrameDouble value="1.3" frame="16" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.32" y1="0.72" x2="0" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.95" frame="22" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="28" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.32" y1="0.72" x2="0" y2="1"/>
