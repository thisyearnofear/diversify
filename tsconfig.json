{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./apps/web/*"
      ],
      "@diversifi/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@diversifi/shared/*": [
        "./packages/shared/*"
      ]
    }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules_hidden",
    "apps/web/.next",
    ".next",
    "out",
    "cache",
    "contracts",
    "lib",
    "**/dist"
  ]
}
